rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put your own user ID here (SETUP.md, step 6). Only these accounts can read everyone's stats.
    function isOwner() {
      return request.auth != null && request.auth.uid in ['kzeEdCTMgHNc4N0l6pIXHCgovzU2'];
    }

    // Each player's saved results. Only that player can read or change them.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Taken usernames. Anyone can check a name; you can only claim one for yourself, once.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
    }

    // Games saved in the first format on launch day. No new ones are written; the owner can read them.
    match /events/{id} {
      allow read: if isOwner();
    }

    // Daily running totals for the owner stats page. Games add to them; only the owner can read them.
    match /stats/{day} {
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.size() < 900;
      allow read: if isOwner();
    }
  }
}
